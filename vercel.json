{
  "cleanUrls": false,
  "rewrites": [{ "source": "/((?!assets|canvaskit|icons|.*\..*).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json|manifest.json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Frame-Options", "value": "DENY" }] }
  ]
}
